# Automex frontend environment.
# Copy to .env.local and fill in. .env.local is never committed.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle — never put a
# secret behind that prefix.

# --- Backend API -----------------------------------------------------------
# Server-side fetches during build and ISR. Include the /api/v1 prefix.
API_URL=http://127.0.0.1:8000/api/v1
# Same API as reachable from the browser. Used only for the contact form POST.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# Django media root, for next/image remotePatterns.
NEXT_PUBLIC_MEDIA_URL=http://127.0.0.1:8000/media/

# --- Public site -----------------------------------------------------------
# Absolute origin. Canonical URLs, hreflang and the sitemap are built from it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Revalidation ----------------------------------------------------------
# Must match REVALIDATE_WEBHOOK_SECRET in the backend .env.
REVALIDATE_SECRET=replace-me-shared-secret

# --- Cloudflare Turnstile (Phase 6; site key is public by design) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Analytics (Phase 7) ---------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

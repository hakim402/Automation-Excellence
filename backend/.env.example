# Automex backend environment.
# Copy to .env and fill in. Every key used anywhere in config/settings/ is listed here.
# .env is never committed.

# --- Core ------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-me-with-50-random-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
TIME_ZONE=America/Los_Angeles

# --- Database --------------------------------------------------------------
DATABASE_URL=postgres://automex:automex@localhost:5432/automex
DB_CONN_MAX_AGE=60

# --- Frontend coupling -----------------------------------------------------
# The public site's origin. Drives CORS and CSRF trusted origins.
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SITE_DOMAIN=https://automex.tech

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=10485760

# --- Rate limiting (DRF throttle rates) ------------------------------------
THROTTLE_LEADS=5/hour
THROTTLE_NEWSLETTER=5/hour

# --- Email (SMTP; Resend recommended) --------------------------------------
# Leave EMAIL_HOST empty in development to print emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Automex <info@automex.tech>
# Comma separated. Who gets notified when a lead arrives.
LEAD_ALERT_RECIPIENTS=
# Absolute backend origin used in staff-only lead alert links.
ADMIN_BASE_URL=http://127.0.0.1:8000
EMAIL_TIMEOUT=10

# --- Groq translation pipeline (Phase 3) -----------------------------------
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT=20
GROQ_MAX_ATTEMPTS=3
GROQ_RETRY_MAX_SECONDS=15
GROQ_BATCH_CHARS=6000
GROQ_MAX_COMPLETION_TOKENS=4096
# Keep synchronous admin operations small; rerun safely to retry missing fields.
TRANSLATION_ADMIN_MAX_RECORDS=3

# --- Cloudflare Turnstile (Phase 4; secret key is server-side only) --------
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT=10
# Must match the hostname and action (lead/newsletter) returned by the frontend widget.
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1
# Only trust direct proxy IP/CIDRs whose proxy overwrites X-Real-IP. Blank trusts no headers.
CAPTURE_TRUSTED_PROXIES=

# --- Publish -> Next.js revalidation webhook (Phase 6) ---------------------
REVALIDATE_WEBHOOK_SECRET=replace-me-shared-secret
REVALIDATE_WEBHOOK_URL=http://localhost:3000/api/revalidate
